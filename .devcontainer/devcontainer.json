{
  "name": "mc-server-test",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installGradle": false
    },
    "ghcr.io/devcontainers-extra/features/actionlint:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "mounts": [
    "source=mc-server-test-gradle,target=/home/vscode/.gradle,type=volume"
  ],
  // Set DEVCONTAINER_USER=root when using rootless Docker.
  "remoteUser": "${localEnv:DEVCONTAINER_USER:vscode}",
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/vscode/.gradle"
  },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "cd test && bash gradlew --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "github.vscode-github-actions"
      ]
    }
  }
}

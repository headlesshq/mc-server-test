{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    ':enablePreCommit',
    'config:best-practices',
  ],
  platform: 'github',
  onboarding: false,
  requireConfig: 'optional',
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  // the nix manager is in beta and disabled by default
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
    {
      // the flake only provides the dev shell, so its inputs are updated together once a month
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      schedule: [
        'on the first day of the month',
      ],
      automerge: false,
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
  ],
}
